APP_NAME="返利网"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rebates
DB_USERNAME=rebates
DB_PASSWORD=

# Local development only.
SMS_DRIVER=log
PLATFORM_QUERY_ALLOWED_HOSTS=
# Optional overrides for platform query defaults. Credentials can also be kept in storage/app/private/platform-query-defaults.json.
# PLATFORM_QUERY_DEFAULT_ENDPOINT=https://api5.v-n-r-1.com/api/backend/trpc/user.list
# PLATFORM_QUERY_DEFAULT_ADMIN_HOST=admin5-public.y-7-l-x.com
# PLATFORM_QUERY_DEFAULT_TENANT_ID=9818088
# PLATFORM_QUERY_DEFAULT_REGION_ID=1
# PLATFORM_QUERY_DEFAULT_CLIENT_LANGUAGE=zh-CN
# PLATFORM_QUERY_DEFAULT_TOKEN=
# PLATFORM_QUERY_DEFAULT_ACCOUNT=
# PLATFORM_QUERY_DEFAULT_FINGERPRINT=
# PLATFORM_QUERY_DEFAULT_TEST_PHONE=
# Set to simulator only on a local integration site.
PLATFORM_FUNDS_DRIVER=
# The Pix simulator is available only in local and testing environments.
PIX_DRIVER=
PIX_SIMULATOR_CALLBACK_KEY=

# Use a private-only bucket for claim evidence. AWS credentials can use the default credential chain.
CLAIM_EVIDENCE_BUCKET=
CLAIM_EVIDENCE_REGION=us-east-1
CLAIM_EVIDENCE_ENDPOINT=
CLAIM_EVIDENCE_KEY=
CLAIM_EVIDENCE_SECRET=
CLAIM_EVIDENCE_PATH_STYLE=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
